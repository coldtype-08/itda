# Copy to ~/.itda.env (NOT into the repo), fill in, then: chmod 600 ~/.itda.env
# Loaded automatically by itda/config.py and the scripts. Never uploaded to the sandbox:
# inside the sandbox the model key is an OpenShell placeholder, and tool keys are opt-in
# (ITDA_SANDBOX_TOOL_KEYS=1) with egress limited to the API hosts in policy/presets/.

# Required: build.nvidia.com API key (Nemotron via NIM; also used to pull nvcr.io NIM images)
NVIDIA_API_KEY=

# Optional collection tools (each tool switches on when its key is present)
TAVILY_API_KEY=
BRAVE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# data.go.kr service key with "한국관광공사_국문 관광정보 서비스_GW" approved
DATA_GO_KR_KEY=
# 한국민족문화대백과사전 OpenAPI key (header X-API-Key)
AKS_API_KEY=
# TMAP (SK open API) app key for pedestrian routes; without it, route uses straight-line estimates
TMAP_APP_KEY=
